# ---------------------------------------------------------------------------
# usage-agent configuration
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# Where to send usage reports. Leave empty to run in local-only mode
# (the agent still prints/records usage, it just never talks to a server).
RELAY_URL=https://your-domain.example

# Shared secret. Must match RELAY_TOKEN on the notify-server.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_TOKEN=

# How often to poll, in seconds. 180 (3 min) is a good default - do not go
# below 60, there is no benefit and it is impolite to the API.
POLL_INTERVAL_SECONDS=180

# Label for this machine, shown in notifications ("desktop", "laptop", ...).
# Defaults to this computer's hostname when left empty.
DEVICE_NAME=

# Label for this Claude account, which is how the server tells your accounts
# apart. Leave it empty and the agent detects the signed-in account from
# Claude Code's own config, so switching accounts keeps each one's window
# tracked separately. Set it only to give an account a name you prefer.
#
# Upgrading: if your .env still says ACCOUNT_LABEL=default, clear it, or every
# account will keep reporting under the same key.
ACCOUNT_LABEL=

# Path to Claude Code's credentials file. Leave empty to auto-detect
# (~/.claude/.credentials.json on Windows and Linux).
CLAUDE_CREDENTIALS_PATH=

# Where the agent keeps its local copy of the last reading.
# Leave empty to use <package>/data/state.json
LOCAL_STATE_PATH=

# --- Turn notifications (optional) -----------------------------------------
# Installed separately with:  node scripts/install-hooks.mjs --apply
# Tells you when a long Claude Code turn finishes, so you can walk away from
# an hour-long job and still hear about it.

# Push when a turn finishes.
NOTIFY_ON_TURN_DONE=true

# Only turns that ran at least this long are worth a push. The Stop hook fires
# at the end of every turn and most turns take seconds, so keep this high
# enough that your phone stays quiet during normal work. 300 = 5 minutes.
NOTIFY_MIN_TURN_SECONDS=300

# Push when a turn dies on an API error - a rate limit, an overloaded API.
# These fire whatever the duration: a job that failed is always worth knowing.
NOTIFY_ON_TURN_FAILURE=true

# Push when Claude is waiting on you - a permission prompt, or an agent asking
# for input - during a job you have already walked away from. Without this, an
# hour-long job can stall at minute three and say nothing.
NOTIFY_ON_TURN_WAITING=true

# How long the turn must already have been running before that counts as
# "walked away". Below this you are probably still watching the screen.
NOTIFY_WAITING_AFTER_SECONDS=120

# Minimum seconds between two waiting pushes for the same turn, so a job
# stalled for an hour does not buzz every few seconds.
NOTIFY_WAITING_COOLDOWN_SECONDS=600

# debug | info | warn | error
LOG_LEVEL=info
