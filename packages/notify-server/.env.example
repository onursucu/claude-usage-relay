# ---------------------------------------------------------------------------
# notify-server configuration
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# Port the HTTP server listens on (put a reverse proxy with TLS in front).
PORT=8787

# Interface to bind. Keep 127.0.0.1 when a reverse proxy is in front of it.
HOST=127.0.0.1

# Shared secret required on every /report and /state request.
# Must match RELAY_TOKEN in the agent's .env.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_TOKEN=

# Where state is persisted. Leave empty to use <package>/data
DATA_DIR=

# --- Notifications (ntfy) --------------------------------------------------
# Base URL of the ntfy server. Use https://ntfy.sh for the public instance,
# or your own URL if you self-host.
NTFY_URL=https://ntfy.sh

# Your topic name. On the public instance anyone who guesses this name can
# read your notifications, so use something long and random, e.g.
#   node -e "console.log('claude-'+require('crypto').randomBytes(8).toString('hex'))"
NTFY_TOPIC=

# Optional access token for a protected/self-hosted ntfy instance.
NTFY_TOKEN=

# --- What to notify about --------------------------------------------------
# A new 5-hour window opened (you sent your first message of a new window).
NOTIFY_ON_WINDOW_START=true

# The 5-hour window expired and your limit is fresh again. This one fires
# from the server's own clock, so it reaches you even while your computer
# is off - which is the whole point of this project.
NOTIFY_ON_WINDOW_RESET=true

# Comma-separated utilization percentages that trigger a warning, once each
# per window. Empty disables threshold warnings.
USAGE_THRESHOLDS=80,95

# Warn when the agent reports that it can no longer read usage data
# (for example because the upstream endpoint changed).
NOTIFY_ON_SOURCE_ERROR=true

# Minimum minutes between two identical source-error notifications.
SOURCE_ERROR_COOLDOWN_MINUTES=180

# Notification language: en | tr
NOTIFY_LANGUAGE=en

# IANA timezone used to format times in notifications, e.g. Europe/Istanbul.
# Leave empty to use the server's local timezone.
DISPLAY_TIMEZONE=

# debug | info | warn | error
LOG_LEVEL=info
