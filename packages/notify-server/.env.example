# ---------------------------------------------------------------------------
# notify-server configuration
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# Port the HTTP server listens on (put a reverse proxy with TLS in front).
PORT=8787

# Interface to bind. Keep 127.0.0.1 when a reverse proxy is in front of it.
HOST=127.0.0.1

# Shared secret required on every /report and /state request.
# Must match RELAY_TOKEN in the agent's .env.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_TOKEN=

# Read-only token for the dashboard at GET /. Separate from RELAY_TOKEN, which
# can write reports and should never be pasted into a browser. Leave empty to
# turn the dashboard off. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASHBOARD_TOKEN=

# Public URL of the dashboard, e.g. https://your-domain.example/ - used for a
# link on the notifications that are about your quota. Empty omits the link.
DASHBOARD_URL=

# Where state is persisted. Leave empty to use <package>/data
DATA_DIR=

# Human names for your accounts, so an alert says which limit just came back.
# Format: key:Name,key:Name - the key is what shows up in GET /state, either
# in full ("claude:33a49bed") or just the account part ("33a49bed").
# Only used once more than one account is tracked; with a single account the
# name would be noise on every notification.
ACCOUNT_LABELS=

# --- Notifications (ntfy) --------------------------------------------------
# Base URL of the ntfy server. Use https://ntfy.sh for the public instance,
# or your own URL if you self-host.
NTFY_URL=https://ntfy.sh

# Your topic name. On the public instance anyone who guesses this name can
# read your notifications, so use something long and random, e.g.
#   node -e "console.log('claude-'+require('crypto').randomBytes(8).toString('hex'))"
NTFY_TOPIC=

# Optional access token for a protected/self-hosted ntfy instance.
NTFY_TOKEN=

# --- What to notify about --------------------------------------------------
# A new 5-hour window opened (you sent your first message of a new window).
NOTIFY_ON_WINDOW_START=true

# The 5-hour window expired and your limit is fresh again. This one fires
# from the server's own clock, so it reaches you even while your computer
# is off - which is the whole point of this project.
NOTIFY_ON_WINDOW_RESET=true

# Comma-separated utilization percentages that trigger a warning, once each
# per window. Empty disables threshold warnings.
USAGE_THRESHOLDS=80,95

# The same, for the weekly window. It fills far more slowly, so the first
# warning comes earlier: by the time a 7-day limit reads 80% on a Thursday,
# the rest of your week is already decided.
USAGE_THRESHOLDS_SEVEN_DAY=50,80,95

# Warn when the agent reports that it can no longer read usage data
# (for example because the upstream endpoint changed).
NOTIFY_ON_SOURCE_ERROR=true

# Minimum minutes between two identical source-error notifications.
SOURCE_ERROR_COOLDOWN_MINUTES=180

# Notification language: en | tr
NOTIFY_LANGUAGE=en

# How late a weekly reset may still be announced. Longer than the 5-hour one:
# "your five hours are back" goes stale fast, "your week turned over" does not.
RESET_GRACE_MINUTES_SEVEN_DAY=180

# IANA timezone used to format times in notifications, e.g. Europe/Istanbul.
# Leave empty to use the server's local timezone.
DISPLAY_TIMEZONE=

# debug | info | warn | error
LOG_LEVEL=info

# --- Opening a window on request (optional) --------------------------------
# Lets a cron job or a button in the phone notification open a 5-hour window
# by sending one minimal prompt. Leave START_TOKEN empty to keep /start off.
#
# The Claude credential does NOT live here. It belongs to the window-starter
# service, which runs as its own OS user on loopback; this server only knows
# how to ask it. Keep that separation - it is why a compromise of this
# internet-facing process cannot become access to your Claude account.

# Secret required on POST /start. Must be different from RELAY_TOKEN: this one
# travels inside phone notifications, so it should only ever be able to open a
# window, never to write reports.
START_TOKEN=

# Where the window-starter service listens, and its own shared secret
# (STARTER_TOKEN in that package's .env must match).
STARTER_URL=http://127.0.0.1:8788
STARTER_TOKEN=
STARTER_TIMEOUT_SECONDS=150

# The account the starter's credential belongs to: its eight-character id, the
# key the dashboard's /state shows after `claude:`. Needed once more than one
# account is tracked; empty uses the only tracked account.
START_ACCOUNT=

# Public URL of this server's /start, used as the target of the "open a
# window" button attached to reset notifications, e.g.
#   https://your-domain.example/start
# Leave empty to send notifications without a button.
START_ACTION_URL=

# How long a successful start keeps blocking further starts, in minutes.
#
# This is the window's length, not a retry delay. A ping that succeeded opened
# a window; opening another before it expires can only waste quota. The server
# stays blind until someone actually runs Claude Code, and that gap is often
# long - a scheduled 08:30 start confirmed at 09:06 fired a second, useless
# ping at 08:50 when this was set to 15.
#
# Retrying a FAILED ping is unaffected: a failure clears the pending start
# immediately.
PENDING_START_TTL_MINUTES=300

# A start you asked for succeeded. Quiet by design: the precise reset time
# arrives separately as the window_start notification.
NOTIFY_ON_START_OK=true

# A start failed. This one is loud on purpose - a scheduled start that dies
# silently (an expired token, a stopped service) would leave you believing a
# window is open when it is not.
NOTIFY_ON_START_FAILED=true
